# Copy this file to .env and adjust if needed.
# .env is git-ignored; .env.example is committed so teammates know what to set.

POSTGRES_USER=safemed
POSTGRES_PASSWORD=safemed_dev_password
POSTGRES_DB=safemed

# 'db' is the service name in docker-compose.yml - Docker resolves it to the
# database container. Port is 5432 (inside the Docker network), not 5433.
DATABASE_URL=postgresql+psycopg://safemed:safemed_dev_password@db:5432/safemed
REDIS_URL=redis://redis:6379/0

ENVIRONMENT=development
# Signs login tokens. Generate your own with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never put a real key in this file. It goes in .env only.
SECRET_KEY=change-me-generate-your-own
