# Secrets and local config
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / frontend
node_modules/
dist/
.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Celery Beat runtime state. Beat rewrites this file constantly, so tracking
# it means a conflict on every pull. It is regenerated automatically.
backend/celerybeat-schedule
backend/celerybeat-schedule.*
backend/celerybeat.pid

# Generated from the Markdown in docs/ by scripts/build_report.py.
# The Markdown is the source of truth; committing both lets them drift.
docs/*.pdf

# Deck dependencies, installed locally by docs/presentation/README.md
docs/presentation/node_modules/
docs/presentation/package*.json

# Office lock files, created while a document is open in Word/PowerPoint/Excel
~$*
