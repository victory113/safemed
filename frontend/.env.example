# Where the SafeMed API lives. Copy this file to .env to override it.
#
#   cp .env.example .env
#
# The origin only - the client appends /api/v1 itself. Leaving this unset is
# fine for local work: the default below is the port docker-compose maps the
# API to, so a fresh clone runs with no .env file at all.
VITE_API_URL=http://localhost:8000
